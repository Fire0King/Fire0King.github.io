[Unit]
Description=Bilibili live gift overtime timer (live-timer)
Documentation=file:///usr/local/bin/live-timer.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
Environment=LIVE_TIMER_CONFIG=/etc/live-timer/config.json
ExecStart=/usr/bin/env node /usr/local/bin/live-timer.mjs --config /etc/live-timer/config.json
Restart=always
RestartSec=5
# /var/lib/live-timer 由 systemd 自动创建并归属 www-data，用来放断点续计的状态文件
StateDirectory=live-timer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
