---
import { Icon } from "astro-icon/components";
import LiveHero from "@/components/pages/live/LiveHero.astro";
import LiveReport from "@/components/pages/live/LiveReport.svelte";
import {
	enabledLivePlatforms,
	isLiveReportConfigured,
	liveReportConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import {
	getDataDates,
	getDataRange,
	getFollowers,
	getLastUpdatedAt,
	getLiveStreams,
} from "@/utils/live-report-data";
import {
	buildMonthOptions,
	getLiveReportLocale,
	getTodayKey,
} from "@/utils/live-report-utils";

// 页面开关
if (!siteConfig.pages.liveReport) {
	return Astro.redirect("/404/");
}

const title = liveReportConfig.title || i18n(I18nKey.liveReport);
const description =
	liveReportConfig.subtitle || i18n(I18nKey.liveReportSubtitle);

// 构建时装载数据（src/data/live/*.json，由 GitHub Actions 定时写入）
const streams = getLiveStreams();
const followers = getFollowers();
const dataDates = getDataDates(streams, followers);
const dataRange = getDataRange(streams, followers);
const lastUpdatedAt = getLastUpdatedAt(streams, followers);

const timezone = liveReportConfig.timezone;
const todayKey = getTodayKey(timezone);
const locale = getLiveReportLocale(siteConfig.lang);
const months = buildMonthOptions(dataDates, todayKey, locale);
// 默认展示最近一个有数据的月份，没有数据时展示当前月
const initialMonth =
	months.find((month) => month.hasData)?.key ??
	months[0]?.key ??
	todayKey.slice(0, 7);

const hasAnyData =
	streams.records.length > 0 ||
	Object.values(followers.series).some(
		(series) => (series?.points?.length ?? 0) > 0,
	);

// 页头元信息：数据更新于 / 数据范围 / 自动采集说明
const metaLine = [
	lastUpdatedAt
		? `${i18n(I18nKey.liveReportLastUpdated)} ${formatDateI18nWithTime(lastUpdatedAt)}`
		: null,
	dataRange
		? `${i18n(I18nKey.liveReportDataRange)} ${dataRange.first} ~ ${dataRange.last}`
		: null,
	i18n(I18nKey.liveReportAutoCollected),
]
	.filter(Boolean)
	.join(" · ");

// hero 是否启用（关掉则数据直接从导航栏下方开始，也不给内容做首屏留白）
const heroEnabled = liveReportConfig.hero.enable;
---

<MainGridLayout heroPage={heroEnabled} title={title} description={description}>
	<!-- 整屏开场 hero（复刻 P3RE-Web-Effect）：首屏只有开场，数据往下滑才出现 -->
	{heroEnabled && (
		<LiveHero
			slot="hero"
			hero={liveReportConfig.hero}
			smallLine={metaLine}
		/>
	)}

	<div id="live-data" class="flex w-full flex-col gap-4">
		<!-- 首屏之下的数据区表头：hero 是纯开场，页面身份与数据信息放这里 -->
		<header class="card-base w-full px-4 sm:px-6 py-4">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
					{title}
				</h2>
				<p class="text-xs text-neutral-500 dark:text-neutral-400">
					{description}
				</p>
			</div>
			<p class="mt-2 text-xs text-neutral-500 dark:text-neutral-500">
				{metaLine}
			</p>
		</header>

		{
			!isLiveReportConfigured ? (
				/* 未配置数据源 */
				<div class="card-base w-full px-4 sm:px-6 py-14 text-center">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
						<Icon
							name="material-symbols:settings"
							class="text-[2rem] text-(--btn-content)"
						/>
					</div>
					<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
						{i18n(I18nKey.liveReportNotConfigured)}
					</h2>
					<p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
						{i18n(I18nKey.liveReportNotConfiguredDesc)}
					</p>
				</div>
			) : (
				<>
					{!hasAnyData && (
						<div class="card-base w-full px-4 py-3 text-sm text-neutral-500 dark:text-neutral-400">
							{i18n(I18nKey.liveReportNoData)} ·{" "}
							{i18n(I18nKey.liveReportNoDataDesc)}
						</div>
					)}
					<LiveReport
						client:load
						records={streams.records}
						active={streams.active}
						followers={followers.series}
						months={months}
						initialMonth={initialMonth}
						platforms={enabledLivePlatforms}
						lang={siteConfig.lang}
						timezone={timezone}
						weekStart={liveReportConfig.weekStart}
						todayKey={todayKey}
					/>
				</>
			)
		}
	</div>

	<!--
		hero 的开场时序 + 滚动淡出：
		  · 文字淡完后（--video-in-delay，默认 5.8s）播放第 1 段背景视频，播完切到第 2 段循环
		    （同参考的 video1/video2）。视频只从这一刻才开播 —— 素材开头本身是纯白，
		    正好接上白底，换幕是无缝的"直接展示"，不做任何淡入
		  · 白底压在视频之上，等视频真的出帧（playing）再整帧收掉；1.2s 兜底避免一直白着
		  · 自动播放被拦截时，在首次用户手势（点按/按键/滚动）后重试
		  · 滚动时 hero 整体淡出；挂载瞬间不做淡出判断，避免切换页面时被误隐藏
		  · hero 渲染在 MainGridLayout 的 #page-hero-layer（fixed、z-index 1090，盖住导航栏），
		    所以首屏完整覆盖时这里主动吞掉点击（pointer-events: auto），避免点到被盖住的
		    导航栏按钮、结果搜索面板开在 hero 底下看不见；开始淡出后立刻改回 none 让点击穿透
		用自定义元素承载：connectedCallback 在每次进入本页（含 Swup 切换）重跑，
		滚动监听 rAF 节流、只写 opacity/pointer-events。定义放 head，保证先于元素升级。
	-->
	<script slot="head" is:inline>
		(function () {
			if (customElements.get("live-hero-fade")) return;
			class LiveHeroFade extends HTMLElement {
				/**
				 * 直接把子节点拿来用是不行的：自定义元素在「解析期升级」时（脚本写在 head 里、
				 * hero 在 body 里，就是这种情况），connectedCallback 会在子节点解析出来之前
				 * 就触发 —— 这时候 querySelector 全是 null，videos 会是空数组，视频永远不会播。
				 * 所以先判断子节点到没到，没到就等 MutationObserver 通知。
				 */
				connectedCallback() {
					if (this.inited) return;
					if (this.hasChildren()) {
						this.init();
						return;
					}
					this.observer = new MutationObserver(() => {
						if (this.inited || !this.hasChildren()) return;
						this.init();
					});
					this.observer.observe(this, { childList: true });
				}

				/** hero 的关键子节点（视频 / 白底）是否已经解析出来 */
				hasChildren() {
					return Boolean(
						this.querySelector("[data-hero-video]") ||
							this.querySelector(".live-hero-white"),
					);
				}

				stopObserving() {
					if (this.observer) {
						this.observer.disconnect();
						this.observer = null;
					}
				}

				init() {
					if (this.inited) return;
					this.inited = true;
					this.stopObserving();

					const reduced = window.matchMedia(
						"(prefers-reduced-motion: reduce)",
					).matches;

					const intro = this.querySelector('[data-hero-video="intro"]');
					const loop = this.querySelector('[data-hero-video="loop"]');
					this.videos = [intro, loop].filter(Boolean);
					this.timers = [];
					this.gestures = [];

					// Swup 是用 innerHTML 替换容器的，而 Chrome/Safari 在 innerHTML 插入时
					// 不会把 muted 属性同步到 video.muted 属性（老问题）。muted 失效 →
					// play() 被自动播放策略拒绝 → 视频永远不播。这里显式设置 property 兜住。
					for (const video of this.videos) {
						video.muted = true;
						video.defaultMuted = true;
						video.playsInline = true;
						video.volume = 0;
						video.setAttribute("muted", "");
						video.setAttribute("playsinline", "");
					}

					/** 当前该播的那一段（第 1 段结束后切第 2 段） */
					const currentVideo = () =>
						intro && intro.style.display !== "none" ? intro : loop;

					let tryPlay;
					/** 自动播放被拦截时，等首次用户手势再试一次 */
					const retryOnGesture = () => {
						if (this.gestures.length > 0) return;
						const handler = () => {
							for (const off of this.gestures) off();
							this.gestures = [];
							tryPlay(currentVideo());
						};
						for (const name of [
							"pointerdown",
							"touchstart",
							"keydown",
							"scroll",
						]) {
							const opts = { once: true, passive: true };
							window.addEventListener(name, handler, opts);
							this.gestures.push(() =>
								window.removeEventListener(name, handler, opts),
							);
						}
					};

					tryPlay = (el) => {
						if (!el) return;
						const result = el.play();
						if (result && typeof result.catch === "function") {
							result.catch((error) => {
								console.warn(
									"[live-hero] 背景视频未能自动播放，将在首次交互后重试：",
									error && error.name,
								);
								retryOnGesture();
							});
						}
					};

					// 视频加载失败 / 解码失败：隐藏它，露出内置动画背景，并且不让开场卡住
					const failed = new Set();
					const applyFallback = (reason) => {
						if (this.getAttribute("data-hero-state") === "fallback") return;
						console.warn(
							"[live-hero] 背景视频不可用，改用内置动画背景：",
							reason,
						);
						this.setAttribute("data-hero-state", "fallback");
					};
					const fail = (el, then) => {
						if (!el) return;
						const note = (reason) => {
							if (failed.has(el)) return;
							failed.add(el);
							el.style.display = "none";
							if (then) then();
							// 只有所有视频都失败，才收起整层视频（否则会连带隐藏还能播的那段）
							if (failed.size >= this.videos.length) applyFallback(reason);
						};
						el.addEventListener(
							"error",
							() => {
								const mediaError = el.error;
								note(
									mediaError
										? `MediaError ${mediaError.code} ${mediaError.message || ""}`
										: "video error 事件",
								);
							},
							{ once: true },
						);
						// <source> 失败时错误事件挂在 source 上；只有全部 source 都失败
						// （networkState 变成 NETWORK_NO_SOURCE）才算这段视频彻底不可用
						for (const source of el.querySelectorAll("source")) {
							source.addEventListener(
								"error",
								() => {
									if (el.networkState === 3) note("所有 source 都无法解码");
								},
								{ once: true },
							);
						}
					};
					fail(intro, () => tryPlay(loop));
					fail(loop);

					// 额外兜底：数据就绪后（canplay）若「当前该播的那段」还没起来，再试一次
					// （应对 play() 调用早于可播放，或首帧被策略拦下的情况）
					for (const video of this.videos) {
						video.addEventListener("canplay", () => {
							if (
								this.videosStarted &&
								video.paused &&
								video === currentVideo()
							) {
								tryPlay(video);
							}
						});
						// 真的播起来了 → 撤销「兜底」状态让视频层显示，并整帧收掉白底
						// （素材开头本来就是白的，交接处看不出；early/late 都无所谓）
						video.addEventListener("playing", () => {
							this.setAttribute("data-hero-state", "playing");
							dropWhite();
						});
					}

					/*
						白底 → 背景视频的交接：
						素材开头本身就是纯白（fv_movie1 前 0.85s 全是白帧），所以两边都不做
						渐变 —— 白底一直盖在视频上面，等视频真的出帧了再整帧收掉白底。
						这样换幕是"直接展示"，也不会因为半透明叠底而露出下面的深色背景
						（那正是之前看着蒙了一层灰的原因）。
					*/
					const white = this.querySelector(".live-hero-white");
					const dropWhite = () => {
						if (white) white.style.display = "none";
						// 开场到此结束：帘子与标题交给 CSS 彻底移除渲染。
						// 不这么做的话，hero 滑过首屏被 visibility: hidden 藏起来时，
						// 浏览器会丢掉这两个已结束的 CSS 动画，上滑回来又重演一遍开场。
						this.setAttribute("data-hero-opening", "done");
					};

					/**
					 * 背景动画入场：默认 5.5s（--video-in-delay，文字刚淡完）。
					 * 视频也从这一刻才开始播，它自己的白开头正好接上白底。
					 */
					this.startVideos = () => {
						if (this.videosStarted) return;
						this.videosStarted = true;
						const first = currentVideo();
						if (!first) {
							// 没配视频：直接露出内置动画背景
							dropWhite();
							return;
						}

						// 第 1 段（intro）播完接着播第 2 段（loop）并循环。
						// intro 在视觉上压着 loop（CSS 里写了 z-index），所以：
						//   1) intro 快到结尾时先把 loop 起播（它在下面，看不见）；
						//   2) loop 真的出帧了，才把 intro 收掉 —— 同一帧换幕，不闪不卡。
						// 不能提前收掉 intro：loop 还没出帧的话会闪一下下面的动画背景；
						// 也不能让 loop 一直可见：它暂停时会画出第 1 帧静止画面，把 intro 盖住。
						if (intro && loop) {
							let loopStarted = false;
							let handedOff = false;
							const startLoop = () => {
								if (loopStarted) return;
								loopStarted = true;
								tryPlay(loop);
							};
							const handOff = () => {
								if (handedOff) return;
								// loop 还没真正出帧就别换，否则中间会空一下
								if (loop.paused || loop.readyState < 2) return;
								handedOff = true;
								intro.style.display = "none";
							};
							loop.addEventListener("playing", handOff);
							intro.addEventListener("ended", handOff, { once: true });
							intro.addEventListener("timeupdate", () => {
								const total = intro.duration;
								if (!Number.isFinite(total)) return;
								if (total - intro.currentTime <= 0.35) startLoop();
							});
						}

						// 兜底：1.2s 还没 playing（自动播放被拦、加载慢）也收掉白底，
						// 免得整屏一直白着（playing 监听在上面统一处理）
						this.timers.push(setTimeout(dropWhite, 1200));
						tryPlay(first);

						// 再过 1.2s 仍未播起来 → 白底/视频一起收起，走内置动画背景。
						// 之后一旦通过用户手势播起来，playing 事件会把状态改回来。
						this.timers.push(
							setTimeout(() => {
								const current = currentVideo();
								if (
									current &&
									current.paused &&
									this.getAttribute("data-hero-state") !== "fallback"
								) {
									applyFallback(
										"入场后 1.2s 仍未开始播放（多为自动播放被拦截）",
									);
								}
							}, 1200),
						);
					};

					// 减少动效时 CSS 已隐藏视频、白底与文字常驻，这里什么都不做
					if (!reduced) {
						this.timers.push(
							setTimeout(
								this.startVideos,
								Math.max(
									0,
									cssSeconds(this, "--video-in-delay", 5.5) * 1000,
								),
							),
						);
					}

					/*
						滚动 = 开关（不是跟滚动比例半透明地压在内容上）：
						  · 往下滑超过 HIDE_AFTER_PX → hero 整块淡出、点击穿透，内容完全看得清；
						  · 回到顶部 SHOW_BEFORE_PX 以内 → hero 再淡回来（两个阈值留回差，避免临界抖动）。
						之前是按滚动比例算 opacity（滑一半就是半透明），hero 会一直糊在正文上面看不清，
						所以改成这种开关式行为。淡出/淡入本身交给 CSS 的 transition，看起来还是渐隐。
						挂载瞬间不做判断：Swup 切页时 scrollY 可能还是上一页的值，会误隐藏。
					*/
					this.style.opacity = "1";
					this.style.visibility = "visible";
					this.style.pointerEvents = "auto";
					if (reduced) return;
					this.ticking = false;
					/** 往下滑超过这么多像素就整块收掉 */
					const HIDE_AFTER_PX = 24;
					/** 回到这个距离以内再放出来 */
					const SHOW_BEFORE_PX = 8;
					this.hidden = false;
					const setHidden = (hide) => {
						if (hide === this.hidden) return;
						this.hidden = hide;
						this.style.opacity = hide ? "0" : "1";
						// hero 是整屏最上层：显示时吞掉点击（否则会点到被盖住的导航栏按钮，
						// 搜索/主题面板开在 hero 底下，看起来像"点了没反应"）；藏起来后还给页面
						this.style.pointerEvents = hide ? "none" : "auto";
						if (hide) {
							for (const video of this.videos) video.pause();
						} else {
							tryPlay(currentVideo());
						}
					};
					this.onScroll = () => {
						if (this.ticking) return;
						this.ticking = true;
						requestAnimationFrame(() => {
							this.ticking = false;
							const y = window.scrollY || 0;
							if (!this.hidden && y > HIDE_AFTER_PX) setHidden(true);
							else if (this.hidden && y <= SHOW_BEFORE_PX) setHidden(false);
						});
					};
					window.addEventListener("scroll", this.onScroll, { passive: true });

					// 底部中间的下拉按钮：平滑滚动到数据区（点完就滑过首屏，hero 单向淡出）
					const scrollBtn = this.querySelector("[data-hero-scroll]");
					if (scrollBtn) {
						this.onScrollClick = () => {
							const target = document.getElementById("live-data");
							if (target) {
								target.scrollIntoView({
									behavior: "smooth",
									block: "start",
								});
							} else {
								window.scrollTo({
									top: window.innerHeight,
									behavior: "smooth",
								});
							}
						};
						scrollBtn.addEventListener("click", this.onScrollClick);
					}
				}

				disconnectedCallback() {
					// 允许元素被移动后重新连接时再初始化一次
					this.inited = false;
					this.stopObserving();
					window.removeEventListener("scroll", this.onScroll);
					for (const timer of this.timers || []) clearTimeout(timer);
					for (const off of this.gestures || []) off();
					if (this.videos) {
						for (const video of this.videos) video.pause();
					}
					const scrollBtn = this.querySelector("[data-hero-scroll]");
					if (scrollBtn && this.onScrollClick) {
						scrollBtn.removeEventListener("click", this.onScrollClick);
					}
				}
			}

			/** 从 hero 根节点的 CSS 变量里读秒数（--video-in-delay 等） */
			function cssSeconds(el, name, fallback) {
				const raw = getComputedStyle(el).getPropertyValue(name);
				const value = Number.parseFloat(raw);
				return Number.isFinite(value) ? value : fallback;
			}

			customElements.define("live-hero-fade", LiveHeroFade);
		})();
	</script>
</MainGridLayout>
