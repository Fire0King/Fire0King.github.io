---
/**
 * 直播加时配置台（/live-timer/config/）
 *
 * 给自己用的工具页：调叠层样式 + 算礼物时长，产出 OBS 地址和服务端配置片段。
 * 页面本身是静态的，不会改动服务器上的任何文件。
 */
import LiveTimerConfigurator from "@components/pages/live-timer/LiveTimerConfigurator.svelte";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "直播加时配置";
const description =
	"调倒计时叠层的样式、算礼物加多少分钟，生成 OBS 地址和服务端配置";
---

<MainGridLayout title={title} description={description}>
	<div class="card-base px-6 py-6 sm:px-9">
		<div class="mb-6">
			<div class="flex items-center gap-3 mb-3">
				<div
					class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
				>
					<Icon name="material-symbols:tune" class="text-[1.5rem]"></Icon>
				</div>
				<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
					{title}
				</h1>
			</div>
			<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
				{description}
			</p>
			<div
				class="flex items-start gap-2 p-3 rounded-lg bg-(--primary)/8 dark:bg-(--btn-regular-bg) border border-(--primary)/30 dark:border-none"
			>
				<Icon
					name="material-symbols:info-outline"
					class="text-(--primary) text-lg shrink-0 mt-0.5"
				/>
				<p class="text-sm text-neutral-700 dark:text-neutral-200 leading-relaxed">
					左边调参数、右边实时预览。样式参数会直接写进 OBS 地址；礼物规则生成的是
					<strong>配置片段</strong>，需要你自己合并进服务器上的
					<code class="px-1 rounded bg-(--btn-regular-bg)">/etc/live-timer/config.json</code>
					并重启服务，页面不会去改服务器。
				</p>
			</div>
		</div>

		<LiveTimerConfigurator client:load />
	</div>
</MainGridLayout>
