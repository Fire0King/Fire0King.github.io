---
/**
 * 直播数据页面的整屏开场 hero
 *
 * 渲染位置：MainGridLayout 的 `#page-hero-layer` —— <body> 直系、position: fixed、
 * z-index 1090 的整屏层，盖在导航栏（z-80）与内容（z-30）之上，所以开场动画是页面
 * 真正的最上层。不能放在壁纸层（#wallpaper-wrapper）里：那一层是 z-index -1 的独立
 * 层叠上下文，放进去的东西永远盖不到导航栏上面。
 *
 * 时序（以默认配置为例；帘子参数与 P3RE-Web-Effect 一致）：
 *   0s         蓝色波浪帘盖住整屏（浪尖为自备素材，内联 SVG）
 *   1s→4s      帘子整体向下退场，露出白底 + 标题（文字为深色）
 *   3.5s       小字（数据更新信息）开始淡入，0.8s 淡完（帘子落完前 0.5s 起）
 *   4.8s       文字整体淡出（小字出现后停留 hero.holdSeconds，默认 0.5s），0.7s 淡完
 *   5.8s       背景视频直接接上（不淡入：素材开头本身就是纯白），播完切下一段循环；
 *              底部中间的下拉按钮同时出现
 *   点击按钮    平滑滚动到下方数据区
 *   向下滚动     超过约半屏时 hero 渐隐（可逆）：上滑回来会重新显示，循环动画继续
 *
 * 白底与视频的交接由脚本控制（不是 CSS 动画）：白底压在视频之上，视频真的出帧后
 * 整帧收掉白底 —— 详见 live.astro 里的 startVideos / dropWhite。
 *
 * 波浪用「内联 SVG」而不是 <img>：主题有全局规则
 * `html[data-wallpaper-mode="fullscreen"] #wallpaper-wrapper img { width:100%!important;
 *  height:100%!important; filter: blur(...)!important }`，任何放在壁纸层里的 <img>
 * 都会被拉成整屏并加模糊（这就是之前波浪又大又糊的原因）。内联 SVG 不受该规则影响，
 * 也方便用 CSS 覆盖素材里写死的 fill。现在 hero 虽然在壁纸层之外，内联 SVG 依然更省事。
 */

import { existsSync, readFileSync } from "node:fs";
import path from "node:path";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { LiveReportHeroConfig } from "@/types/liveReportConfig";
import { url } from "@/utils/url-utils";

interface Props {
	hero: LiveReportHeroConfig;
	/** 小字：数据信息行（数据更新于 …） */
	smallLine?: string;
}

const { hero, smallLine } = Astro.props;

/** 帘子上缘的浪尖：读取 public/images/live-hero/wave-1..5.svg 的源码内联进页面 */
const CURTAIN_LAYERS = [1, 2, 3, 4, 5];
const waveSvgs = CURTAIN_LAYERS.map((layer) =>
	readFileSync(
		path.join(process.cwd(), `public/images/live-hero/wave-${layer}.svg`),
		"utf8",
	),
);

/** public 下的路径是否存在（构建期判断，用于决定要不要给视频加 mp4 兜底源） */
function publicFileExists(publicPath: string): boolean {
	return existsSync(path.join(process.cwd(), "public", publicPath));
}

/**
 * 生成 <source> 列表：WebM（体积小，Chrome/Edge/Firefox 优先命中）在前，
 * 同名 mp4 作为兜底（Safari 等不支持 VP9/WebM 的浏览器会跳到它）。
 */
function videoSources(
	src: string | undefined,
): { src: string; type: string }[] {
	if (!src) return [];
	const sources: { src: string; type: string }[] = [];
	const ext = src.split(".").pop()?.toLowerCase();
	sources.push({
		src: url(src),
		type: ext === "webm" ? "video/webm" : "video/mp4",
	});
	if (ext === "webm") {
		const mp4 = src.replace(/\.webm$/i, ".mp4");
		if (publicFileExists(mp4)) {
			sources.push({ src: url(mp4), type: "video/mp4" });
		}
	}
	return sources;
}

const [introVideoSrc, loopVideoSrc] = hero.backgroundVideos;
const introSources = videoSources(introVideoSrc);
const loopSources = videoSources(loopVideoSrc);
const hasIntroVideo = introSources.length > 0;
const hasLoopVideo = loopSources.length > 0;
const hasVideo = hasIntroVideo || hasLoopVideo;

const waveColor =
	hero.waveColor.trim() === "theme" ? "var(--primary)" : hero.waveColor;
/** 帘子结束的时刻（延迟 + 时长） */
const curtainEnd = hero.curtainDelaySeconds + hero.curtainDurationSeconds;
/** 小字淡入时长；与下面 CSS 里的 var(--meta-in-duration) 同源 */
const META_IN_DURATION = 0.8;
/** 文字淡出时长；与下面 CSS 里的 var(--text-out-duration) 同源 */
const TEXT_OUT_DURATION = 0.7;
/** 动画入场比文字淡完再晚一点，避免两段动画黏在一起 */
const VIDEO_IN_GAP = 0.3;
/** 小字：在帘子完全落下前 0.5s 开始出现 */
const metaInDelay = Math.max(0, curtainEnd - 0.5);
/** 文字淡出：小字完全出现后，再停留 hero.holdSeconds 秒开始淡出 */
const textOutDelay = metaInDelay + META_IN_DURATION + hero.holdSeconds;
/** 背景动画入场：文字淡完之后 */
const videoInDelay = textOutDelay + TEXT_OUT_DURATION + VIDEO_IN_GAP;
/** 预计算：避免在模板的 if 条件里直接用大于号（容易踩到 Astro 解析坑） */
const hasIntroLines = hero.introLines.length > 0;
const hasSmallLine = Boolean(smallLine?.trim());
const rootClass = hasVideo ? "live-hero" : "live-hero no-video";
const rootStyle = `--hero-wave: ${waveColor}; --curtain-delay: ${hero.curtainDelaySeconds}s; --curtain-duration: ${hero.curtainDurationSeconds}s; --curtain-end: ${curtainEnd}s; --meta-in-delay: ${metaInDelay}s; --meta-in-duration: ${META_IN_DURATION}s; --text-out-delay: ${textOutDelay}s; --text-out-duration: ${TEXT_OUT_DURATION}s; --video-in-delay: ${videoInDelay}s;`;
---

<live-hero-fade class={rootClass} data-hero style={rootStyle}>
	<!-- 内置动画背景：视频未配置/加载失败时的兜底 -->
	<div class="live-hero-backdrop" aria-hidden="true">
		<span class="live-hero-band band-1"></span>
		<span class="live-hero-band band-2"></span>
		<span class="live-hero-band band-3"></span>
		<span class="live-hero-glow"></span>
	</div>

	<!-- 白底：帘子退场后先呈现它 + 文字，停留几秒再让动画入场 -->
	<div class="live-hero-white" aria-hidden="true"></div>

	<!-- 背景动画（视频）：白底之后露出来（不做淡入，见下面 .live-hero-white 的说明） -->
	{hasIntroVideo && (
		<video
			class="live-hero-video"
			data-hero-video="intro"
			muted
			playsinline
			preload="auto"
			loop={!hasLoopVideo}
		>
			{introSources.map((source) => (
				<source src={source.src} type={source.type} />
			))}
		</video>
	)}
	{hasLoopVideo && (
		<video
			class="live-hero-video"
			data-hero-video="loop"
			muted
			loop
			playsinline
			preload="auto"
		>
			{loopSources.map((source) => (
				<source src={source.src} type={source.type} />
			))}
		</video>
	)}

	<!-- 文字：大字（站点标题）+ 小字（数据更新信息） -->
	<div class="live-hero-center">
		<p class="live-hero-center-title">{hero.title}</p>
		{hasIntroLines && (
			<p class="live-hero-center-lines">
				{hero.introLines.map((line) => (
					<span class="live-hero-line">{line}</span>
				))}
			</p>
		)}
		{hasSmallLine && <p class="live-hero-center-meta">{smallLine}</p>}
	</div>

	<!-- 右侧品牌图（可选） -->
	{hero.logo && <img class="live-hero-logo" src={url(hero.logo)} alt="" />}

	<!-- 底部中间的下拉按钮：动画入场后出现，点击滚动到数据区 -->
	<button type="button" class="live-hero-scroll-btn" data-hero-scroll>
		<span>{i18n(I18nKey.liveReportHeroButton)}</span>
		<svg class="live-hero-scroll-icon" viewBox="0 0 24 24" fill="none">
			<path
				d="M6 9.5 12 15.5 18 9.5"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</button>

	<!-- 开场帘子：整屏实色块向下退场，上缘 5 层浪尖领跑 -->
	<div class="live-hero-curtain" data-hero-curtain aria-hidden="true">
		{waveSvgs.map((svg, index) => (
			<span class={`live-hero-curtain-wave wave-${index + 1}`} set:html={svg} />
		))}
	</div>
</live-hero-fade>

<style>
	.live-hero {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background-color: #469ce5;
		color: #0b1020;
	}

	/* ── 内置动画背景（兜底）──────────────────────────── */
	.live-hero-backdrop {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		background: radial-gradient(
			circle at 50% 42%,
			#17456f 0%,
			#0b1c2f 52%,
			#05080f 100%
		);
	}

	.live-hero-band {
		position: absolute;
		left: -30%;
		width: 160%;
		height: 24%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(70, 156, 229, 0.55),
			transparent
		);
		filter: blur(26px);
		will-change: transform;
	}

	.live-hero-band.band-1 {
		top: 14%;
		transform: rotate(-13deg);
		animation: live-hero-drift 16s ease-in-out infinite;
	}

	.live-hero-band.band-2 {
		top: 46%;
		opacity: 0.72;
		transform: rotate(-9deg);
		animation: live-hero-drift 21s ease-in-out infinite reverse;
	}

	.live-hero-band.band-3 {
		top: 74%;
		opacity: 0.5;
		transform: rotate(-16deg);
		animation: live-hero-drift 26s ease-in-out infinite;
	}

	@keyframes live-hero-drift {
		50% {
			transform: translate3d(5%, 4%, 0) rotate(-13deg);
		}
	}

	.live-hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(70, 156, 229, 0.28),
			transparent 62%
		);
		animation: live-hero-glow 11s ease-in-out infinite;
	}

	@keyframes live-hero-glow {
		50% {
			opacity: 0.55;
		}
	}

	/*
		── 白底阶段 ─────────────────────────────────────
		白底压在背景视频之上，一直盖到「视频真的出帧」那一刻，由脚本整帧收掉。
		不做淡出、视频也不做淡入：
		  · 素材开头本身就是纯白（fv_movie1 前 0.85s 都是白帧），收掉白底的那一帧
		    和视频的第一帧是同一种白，等于无缝换幕；
		  · 半透明叠底会露出下面的动画背景，观感就是"蒙了一层灰"，所以两边都不要渐变。
	*/
	.live-hero-white {
		position: absolute;
		inset: 0;
		z-index: 4;
		background-color: #ffffff;
	}

	/* ── 背景视频 ────────────────────────────────────── */
	.live-hero-video {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/*
		两段视频的叠放顺序必须写死：第 1 段（intro）在上面，第 2 段（loop）在下面。
		同 z-index 时按 DOM 顺序画，而 loop 在后面 —— 它预加载好之后即使还是暂停状态，
		浏览器也会把它的第 1 帧画出来，结果就是「暂停的 loop 静止帧盖住正在播的 intro」，
		看上去就是一张不会动的图片。所以 intro 要更高一层，等它播完了再整帧露出 loop。
	*/
	.live-hero-video[data-hero-video="intro"] {
		z-index: 3;
	}

	/*
		视频不可用（解码失败 / 自动播放被拦 / 低电量模式不解码）时，脚本会打上
		data-hero-state="fallback"：白底与视频一起收起，露出下面那层内置动画背景，
		保证任何情况下屏幕上都有动画在跑，而不是一片黑或者一直白着。
	*/
	live-hero-fade[data-hero-state="fallback"] .live-hero-video,
	live-hero-fade[data-hero-state="fallback"] .live-hero-white {
		display: none;
	}

	/*
		开场演完（视频接上 / 走兜底）后脚本会打上 data-hero-opening="done"：
		把帘子和开场文字彻底移出渲染。

		为什么不能只靠动画的 forwards：hero 滑过首屏时会被设成 visibility: hidden，
		浏览器会把这种「不参与渲染」子树里已结束的 CSS 动画丢掉，等再滚回来时按
		原始声明重建 —— 于是帘子又扫一次、标题又淡入一次。这里直接 display: none，
		既省掉重建，也保证上滑回来只看到循环动画。
	*/
	live-hero-fade[data-hero-opening="done"] .live-hero-curtain,
	live-hero-fade[data-hero-opening="done"] .live-hero-center {
		display: none;
	}

	/* ── 文字 ────────────────────────────────────────── */
	.live-hero-center {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 5;
		width: min(92%, 48rem);
		text-align: center;
		color: #0b1020;
		transform: translate(-50%, -50%);
		/* 小字完全出现后再停留一小会儿就淡出（时长由 --text-out-duration 控制） */
		animation: live-hero-text-out var(--text-out-duration, 0.7s) ease-in
			var(--text-out-delay, 4.8s) forwards;
	}

	@keyframes live-hero-text-out {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}

	.live-hero-center-title {
		font-size: clamp(2.2rem, 7vw, 4rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.02em;
	}

	.live-hero-center-lines {
		margin-top: 0.9rem;
		font-size: clamp(0.85rem, 2.4vw, 1.05rem);
		line-height: 1.85;
		opacity: 0.94;
	}

	.live-hero-line {
		display: block;
	}

	/* 小字（数据更新信息）：帘子完全落下前 0.5s 开始淡入，常驻 */
	.live-hero-center-meta {
		margin-top: 1.1rem;
		font-size: 0.8rem;
		line-height: 1.7;
		opacity: 0;
		animation: live-hero-meta-in var(--meta-in-duration, 0.8s) ease-out
			var(--meta-in-delay, 3.5s) forwards;
	}

	@keyframes live-hero-meta-in {
		to {
			opacity: 0.85;
		}
	}

	/* ── 右侧品牌图 ──────────────────────────────────── */
	.live-hero-logo {
		position: absolute;
		top: 50%;
		right: 12%;
		z-index: 5;
		opacity: 0;
		transform: translateY(-50%);
		animation: live-hero-logo-in 1.2s ease-out var(--video-in-delay, 7s) forwards;
	}

	@keyframes live-hero-logo-in {
		to {
			opacity: 1;
		}
	}

	/*
		品牌图在 hero 图层里（#page-hero-layer），已经不受壁纸层那条
		`#wallpaper-wrapper img { width/height 100% + blur }` 全局规则影响；
		这里只按需要收一下尺寸，顺便用 !important 兜住将来别的全局 img 规则。
	*/
	:global(#page-hero-layer) .live-hero-logo {
		width: auto !important;
		height: auto !important;
		max-width: 26vw;
		object-fit: contain !important;
		filter: none !important;
	}

	/* ── 底部中间的下拉按钮 ───────────────────────────── */
	.live-hero-scroll-btn {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		z-index: 6;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-radius: 9999px;
		background: rgba(10, 20, 35, 0.62);
		color: #fff;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		/* 壁纸层是 pointer-events: none，这里显式打开才能点到 */
		pointer-events: auto;
		opacity: 0;
		transform: translateX(-50%) translateY(10px);
		animation: live-hero-btn-in 0.6s ease-out var(--video-in-delay, 7s) forwards;
	}

	.live-hero-scroll-btn:hover {
		background: rgba(10, 20, 35, 0.82);
	}

	.live-hero-scroll-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	@keyframes live-hero-btn-in {
		to {
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}
	}

	.live-hero-scroll-icon {
		width: 1rem;
		height: 1rem;
		animation: live-hero-btn-bob 1.8s ease-in-out infinite;
	}

	@keyframes live-hero-btn-bob {
		50% {
			transform: translateY(4px);
		}
	}

	/* ── 开场帘子 ────────────────────────────────────── */
	.live-hero-curtain {
		position: absolute;
		top: -10%;
		right: 0;
		left: 0;
		z-index: 7;
		height: 120%;
		background-color: var(--hero-wave, #469ce5);
		animation: live-hero-curtain-sweep var(--curtain-duration, 3s) ease-out
			var(--curtain-delay, 1s) both;
		will-change: transform;
	}

	@keyframes live-hero-curtain-sweep {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(100%);
		}
	}

	/*
		浪尖：按素材的原始尺寸渲染（1920×200 水平居中，两侧裁切），不做缩放，
		避免浪形被拉伸；素材 ink 集中在底部约 1/4，正好贴着帘子上缘。
	*/
	.live-hero-curtain-wave {
		position: absolute;
		left: calc(50% - 960px);
		width: 1920px;
		height: 200px;
		will-change: transform;
	}

	.live-hero-curtain-wave :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* 覆盖素材里写死的 fill，让波浪颜色跟随配置（默认就是素材本身的 P3R 蓝） */
	.live-hero-curtain-wave :global(path) {
		fill: var(--hero-wave, #469ce5);
	}

	.live-hero-curtain-wave.wave-1 {
		bottom: calc(100% - 0.1vw);
		opacity: 0.8;
		animation: live-wave-bob-1 5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-2 {
		bottom: calc(100% + 0.5vw);
		opacity: 0.7;
		animation: live-wave-bob-2 4s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-3 {
		bottom: calc(100% + 0.3vw);
		opacity: 0.6;
		animation: live-wave-bob-3 3.5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-4 {
		bottom: calc(100% + 0.1vw);
		opacity: 0.5;
		animation: live-wave-bob-4 3s ease-in-out infinite;
	}

	/* 第 5 层与参考的 #shape 一样不浮动，压在帘子上缘 */
	.live-hero-curtain-wave.wave-5 {
		bottom: calc(100% - 1vw);
		opacity: 1;
	}

	@keyframes live-wave-bob-1 {
		50% {
			transform: translateY(35px);
		}
	}

	@keyframes live-wave-bob-2 {
		50% {
			transform: translateY(25px);
		}
	}

	@keyframes live-wave-bob-3 {
		50% {
			transform: translateY(20px);
		}
	}

	@keyframes live-wave-bob-4 {
		50% {
			transform: translateY(20px);
		}
	}

	@media (max-width: 767px) {
		:global(#page-hero-layer) .live-hero-logo {
			right: 8% !important;
			max-width: 40vw;
		}

		.live-hero-scroll-btn {
			bottom: 1.4rem;
		}
	}

	/* 减少动效：不做帘子/切换，直接呈现「白底 + 深色文字 + 按钮」（脚本也不再收白底） */
	@media (prefers-reduced-motion: reduce) {
		.live-hero-curtain,
		.live-hero-curtain-wave,
		.live-hero-band,
		.live-hero-glow,
		.live-hero-scroll-icon {
			animation: none;
		}

		.live-hero-curtain {
			display: none;
		}

