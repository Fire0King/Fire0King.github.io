---
/**
 * 直播数据页面的整屏开场 hero
 *
 * 逐条复刻 https://github.com/Electr0ME/P3RE-Web-Effect （仿女神异闻录3 Reload官网开场特效）：
 *
 * | 参考实现                        | 本实现                                                  |
 * | ------------------------------- | ------------------------------------------------------- |
 * | .startwaves 固定 120vh 蓝色块    | .live-hero-curtain（同一几何与配色）                     |
 * | animation: down 3s 1s ease-out  | --curtain-duration / --curtain-delay（默认 3s / 1s）     |
 * | translateY(-10vh) → (110vh)     | translateY(0) → translateY(100%)（同一段位移）           |
 * | 5 张波浪图挂在上缘、1~4 层浮动   | 5 层 SVG，同一挂法（bottom:100%）与错位浮动              |
 * | 视频背景：movie1 播完切 movie2 循环 | backgroundVideos 配置项；留空时用内置 CSS 动画背景替代 |
 * | #centertext 居中，3s 后 1.5s 淡出 | .live-hero-center（标题 + 引文，同一时序）               |
 * | #p3relogo 右侧 12%，5s 后 1.5s 淡入 | .live-hero-logo（配置 logo 路径后启用，同一时序与位置） |
 *
 * 本页面是博客的一个页面而非独立开场页，因此额外做了两点适配：
 *   · hero 是固定层，下滑后按滚动淡出，避免浮在数据区后面
 *   · 标题用 <p> 而非 <h1>（布局里已有 sr-only 的 h1），页面标题与数据信息放在首屏之下的数据区
 *
 * 视频素材说明：参考里的两段 mp4 是 P3RE 官方宣传素材，未随仓库分发；
 * 把 mp4 放到 public/ 并在 live-report.config.json 的 hero.backgroundVideos 里填路径即可完全复刻。
 */

import type { LiveReportHeroConfig } from "@/types/liveReportConfig";
import { url } from "@/utils/url-utils";

interface Props {
	hero: LiveReportHeroConfig;
}

const { hero } = Astro.props;

/** 波浪层：帘子上缘 5 层（第 5 层不动，对应参考里的 #shape） */
const CURTAIN_LAYERS = [1, 2, 3, 4, 5];

/** 浪脊路径：起伏不均的浪尖（参考里的波浪图也是这种不规则浪形），1440×200 */
const WAVE_PATH =
	"M0,150 C60,120 120,58 200,70 C280,82 320,142 400,134 C470,127 500,38 580,42 C660,46 690,122 770,130 C840,137 880,68 960,64 C1040,60 1080,132 1160,140 C1240,148 1280,58 1360,50 C1420,44 1450,92 1440,104 L1440,200 L0,200 Z";

const [introVideoSrc, loopVideoSrc] = hero.backgroundVideos;
/** 视频路径经 url() 处理，子路径部署（GitHub Pages 项目页等）下也能正确加载 */
const introVideo = introVideoSrc ? url(introVideoSrc) : undefined;
const loopVideo = loopVideoSrc ? url(loopVideoSrc) : undefined;
const waveColor =
	hero.waveColor.trim() === "theme" ? "var(--primary)" : hero.waveColor;
/** 开场文字淡出：参考里是固定 3s —— 帘子扫到一半时文字就开始淡出 */
const introFadeDelay = Math.min(
	3,
	hero.curtainDelaySeconds + hero.curtainDurationSeconds,
);
/** 品牌图淡入：参考里是 5s（帘子结束后 1s） */
const logoFadeDelay =
	hero.curtainDelaySeconds + hero.curtainDurationSeconds + 1;
/** 预计算：避免在模板的 if 条件里直接用大于号（容易踩到 Astro 解析坑） */
const hasIntroLines = hero.introLines.length > 0;
---

<live-hero-fade
	class="live-hero"
	data-hero
	style={`--hero-wave: ${waveColor}; --curtain-delay: ${hero.curtainDelaySeconds}s; --curtain-duration: ${hero.curtainDurationSeconds}s; --intro-fade-delay: ${introFadeDelay}s; --logo-fade-delay: ${logoFadeDelay}s;`}
>
	<!-- 背景：内置动画背景常驻打底（视频加载失败时兜底），视频按参考顺序叠在其上 -->
	<div class="live-hero-bg" aria-hidden="true">
		<div class="live-hero-backdrop">
			<span class="live-hero-band band-1"></span>
			<span class="live-hero-band band-2"></span>
			<span class="live-hero-band band-3"></span>
			<span class="live-hero-glow"></span>
		</div>
		{introVideo && (
			<video
				class="live-hero-video"
				data-hero-video="intro"
				src={introVideo}
				muted
				playsinline
				preload="auto"
			/>
		)}
		{loopVideo && (
			<video
				class="live-hero-video"
				data-hero-video="loop"
				src={loopVideo}
				muted
				loop
				playsinline
				preload="auto"
			/>
		)}
	</div>

	<!-- 开场文字：居中，帘子扫完后按参考时序淡出 -->
	<div class="live-hero-center">
		<p class="live-hero-center-title">{hero.title}</p>
		{hasIntroLines && (
			<p class="live-hero-center-lines">
				{hero.introLines.map((line) => (
					<span class="live-hero-line">{line}</span>
				))}
			</p>
		)}
	</div>

	<!-- 右侧品牌图：参考里右侧 12%、垂直居中，5s 后淡入 -->
	{hero.logo && <img class="live-hero-logo" src={hero.logo} alt="" />}

	<!-- 开场帘子：整屏蓝色块向下退场，浪尖挂在上缘领跑 -->
	<div class="live-hero-curtain" data-hero-curtain aria-hidden="true">
		{
			CURTAIN_LAYERS.map((layer) => (
				<svg
					class={`live-hero-curtain-wave wave-${layer}`}
					viewBox="0 0 1440 200"
					preserveAspectRatio="none"
				>
					<path d={WAVE_PATH} />
				</svg>
			))
		}
	</div>
</live-hero-fade>

<style>
	.live-hero {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background-color: #469ce5;
	}

	/* ── 背景 ────────────────────────────────────────── */
	.live-hero-bg {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.live-hero-video {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 内置动画背景（视频未配置或加载失败时显示）：深蓝底 + 缓慢漂移的光带 */
	.live-hero-backdrop {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		background:
			radial-gradient(
				circle at 50% 42%,
				#17456f 0%,
				#0b1c2f 52%,
				#05080f 100%
			);
	}

	.live-hero-band {
		position: absolute;
		left: -30%;
		width: 160%;
		height: 24%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(70, 156, 229, 0.55),
			transparent
		);
		filter: blur(26px);
		will-change: transform;
	}

	.live-hero-band.band-1 {
		top: 14%;
		transform: rotate(-13deg);
		animation: live-hero-drift 16s ease-in-out infinite;
	}

	.live-hero-band.band-2 {
		top: 46%;
		opacity: 0.72;
		transform: rotate(-9deg);
		animation: live-hero-drift 21s ease-in-out infinite reverse;
	}

	.live-hero-band.band-3 {
		top: 74%;
		opacity: 0.5;
		transform: rotate(-16deg);
		animation: live-hero-drift 26s ease-in-out infinite;
	}

	@keyframes live-hero-drift {
		50% {
			transform: translate3d(5%, 4%, 0) rotate(-13deg);
		}
	}

	.live-hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(70, 156, 229, 0.28),
			transparent 62%
		);
		animation: live-hero-glow 11s ease-in-out infinite;
	}

	@keyframes live-hero-glow {
		50% {
			opacity: 0.55;
		}
	}

	/* ── 开场文字（参考 #centertext）────────────────────── */
	.live-hero-center {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		width: min(92%, 46rem);
		text-align: center;
		color: #fff;
		transform: translate(-50%, -50%);
		animation: live-hero-center-out 1.5s linear var(--intro-fade-delay, 4s)
			forwards;
	}

	@keyframes live-hero-center-out {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}

	.live-hero-center-title {
		font-size: clamp(2rem, 6vw, 3.2rem);
		font-weight: 700;
		line-height: 1.15;
		text-shadow: 0 3px 26px rgba(0, 0, 0, 0.5);
	}

	.live-hero-center-lines {
		margin-top: 0.9rem;
		font-size: clamp(0.85rem, 2.4vw, 1.05rem);
		line-height: 1.85;
		opacity: 0.94;
	}

	.live-hero-line {
		display: block;
	}

	/* ── 右侧品牌图（参考 #p3relogo）───────────────────── */
	.live-hero-logo {
		position: absolute;
		top: 50%;
		right: 12%;
		z-index: 3;
		max-width: 26vw;
		opacity: 0;
		transform: translateY(-50%);
		animation: live-hero-logo-in 1.5s linear var(--logo-fade-delay, 5s) forwards;
	}

	@keyframes live-hero-logo-in {
		to {
			opacity: 1;
		}
	}

	/* ── 开场帘子（参考 .startwaves）───────────────────── */
	.live-hero-curtain {
		position: absolute;
		top: -10%;
		right: 0;
		left: 0;
		z-index: 4;
		height: 120%;
		background-color: var(--hero-wave, #469ce5);
		animation: live-hero-curtain-sweep var(--curtain-duration, 3s) ease-out
			var(--curtain-delay, 1s) both;
		will-change: transform;
	}

	@keyframes live-hero-curtain-sweep {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(100%);
		}
	}

	/* 浪尖挂在上缘：随帘子一起下移，成为退场时的浪形前沿 */
	.live-hero-curtain-wave {
		position: absolute;
		left: 0;
		width: 100%;
		height: 11vh;
		fill: var(--hero-wave, #469ce5);
		will-change: transform;
	}

	.live-hero-curtain-wave.wave-1 {
		bottom: calc(100% - 0.1vw);
		opacity: 0.8;
		animation: live-wave-bob-1 5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-2 {
		bottom: calc(100% + 0.5vw);
		opacity: 0.7;
		animation: live-wave-bob-2 4s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-3 {
		bottom: calc(100% + 0.3vw);
		opacity: 0.6;
		animation: live-wave-bob-3 3.5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-4 {
		bottom: calc(100% + 0.1vw);
		opacity: 0.5;
		animation: live-wave-bob-4 3s ease-in-out infinite;
	}

	/* 第 5 层与参考的 #shape 一样不带动画，压在帘子上缘 */
	.live-hero-curtain-wave.wave-5 {
		bottom: calc(100% - 1vw);
		opacity: 1;
	}

	@keyframes live-wave-bob-1 {
		50% {
			transform: translateY(35px);
		}
	}

	@keyframes live-wave-bob-2 {
		50% {
			transform: translateY(25px);
		}
	}

	@keyframes live-wave-bob-3 {
		50% {
			transform: translateY(20px);
		}
	}

	@keyframes live-wave-bob-4 {
		50% {
			transform: translateY(20px);
		}
	}

	@media (max-width: 767px) {
		.live-hero-curtain-wave {
			height: 8vh;
		}

		.live-hero-logo {
			right: 8%;
			max-width: 40vw;
		}
	}

	/* 减少动效：帘子/浮动/淡入淡出全部取消，直接呈现静态开场 */
	@media (prefers-reduced-motion: reduce) {
		.live-hero-curtain,
		.live-hero-curtain-wave,
		.live-hero-band,
		.live-hero-glow,
		.live-hero-center,
		.live-hero-logo {
			animation: none;
		}

		.live-hero-curtain {
			display: none;
		}

		.live-hero-logo {
			opacity: 1;
		}
	}
</style>
