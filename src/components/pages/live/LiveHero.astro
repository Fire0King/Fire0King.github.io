---
/**
 * 直播数据页面的整屏开场 hero
 *
 * 结构复刻 https://github.com/Electr0ME/P3RE-Web-Effect （仿女神异闻录3 Reload官网开场特效），
 * 波浪素材与背景视频使用本站自备的素材（public/ 下）。
 *
 * 时序（默认与参考一致）：
 *   0s        帘子（整屏实色块 + 上缘 5 层浪尖）盖住整屏
 *   1s 起 3s   帘子整体向下退场，露出背景；浪尖挂在帘子上缘领跑
 *   4s        数据信息行（小字）淡入
 *   5s        右侧品牌图淡入（若配置了 logo）
 *
 * 与参考的差异（本页是博客里的一页，不是独立开场页）：
 *   · 大字为站点标题、常驻不淡出；小字为数据更新信息
 *   · hero 是固定层，滚动时整体淡出，避免浮在数据区后面
 *   · 背景视频加载失败或未配置时，露出内置的 CSS 动画背景
 */

import { existsSync } from "node:fs";
import path from "node:path";
import type { LiveReportHeroConfig } from "@/types/liveReportConfig";
import { url } from "@/utils/url-utils";

interface Props {
	hero: LiveReportHeroConfig;
	/** 小字：数据信息行（数据更新于 …） */
	smallLine?: string;
}

const { hero, smallLine } = Astro.props;

/** 帘子上缘的浪尖：用 public/images/live-hero/wave-1..5.svg（参考同款素材） */
const CURTAIN_LAYERS = [1, 2, 3, 4, 5];

/** public 下的路径是否存在（构建期判断，用于决定要不要给视频加 mp4 兜底源） */
function publicFileExists(publicPath: string): boolean {
	return existsSync(path.join(process.cwd(), "public", publicPath));
}

/**
 * 生成 <source> 列表：WebM（体积小，Chrome/Edge/Firefox 优先命中）在前，
 * 同名 mp4 作为兜底（Safari 等不支持 VP9/WebM 的浏览器会跳到它）。
 */
function videoSources(
	src: string | undefined,
): { src: string; type: string }[] {
	if (!src) return [];
	const sources: { src: string; type: string }[] = [];
	const ext = src.split(".").pop()?.toLowerCase();
	sources.push({
		src: url(src),
		type: ext === "webm" ? "video/webm" : "video/mp4",
	});
	if (ext === "webm") {
		const mp4 = src.replace(/\.webm$/i, ".mp4");
		if (publicFileExists(mp4)) {
			sources.push({ src: url(mp4), type: "video/mp4" });
		}
	}
	return sources;
}

const [introVideoSrc, loopVideoSrc] = hero.backgroundVideos;
const introSources = videoSources(introVideoSrc);
const loopSources = videoSources(loopVideoSrc);
const hasIntroVideo = introSources.length > 0;
const hasLoopVideo = loopSources.length > 0;

const waveColor =
	hero.waveColor.trim() === "theme" ? "var(--primary)" : hero.waveColor;
/** 帘子结束的时刻（延后 + 时长），小字在这之后淡入 */
const curtainEnd = hero.curtainDelaySeconds + hero.curtainDurationSeconds;
/** 品牌图淡入：参考里是帘子结束后 1s */
const logoFadeDelay = curtainEnd + 1;
/** 预计算：避免在模板的 if 条件里直接用大于号（容易踩到 Astro 解析坑） */
const hasIntroLines = hero.introLines.length > 0;
const hasSmallLine = Boolean(smallLine?.trim());
---

<live-hero-fade
	class="live-hero"
	data-hero
	style={`--hero-wave: ${waveColor}; --curtain-delay: ${hero.curtainDelaySeconds}s; --curtain-duration: ${hero.curtainDurationSeconds}s; --curtain-end: ${curtainEnd}s; --logo-fade-delay: ${logoFadeDelay}s;`}
>
	<!-- 背景：内置动画背景常驻打底（视频加载失败时兜底），视频按参考顺序叠在其上 -->
	<div class="live-hero-bg" aria-hidden="true">
		<div class="live-hero-backdrop">
			<span class="live-hero-band band-1"></span>
			<span class="live-hero-band band-2"></span>
			<span class="live-hero-band band-3"></span>
			<span class="live-hero-glow"></span>
		</div>
		{hasIntroVideo && (
			<video
				class="live-hero-video"
				data-hero-video="intro"
				muted
				playsinline
				preload="auto"
			>
				{introSources.map((source) => (
					<source src={source.src} type={source.type} />
				))}
			</video>
		)}
		{hasLoopVideo && (
			<video
				class="live-hero-video"
				data-hero-video="loop"
				muted
				loop
				playsinline
				preload="auto"
			>
				{loopSources.map((source) => (
					<source src={source.src} type={source.type} />
				))}
			</video>
		)}
	</div>

	<!-- 轻压暗：保证白色标题在视频/壁纸上可读（比参考多这一层，文字是常驻的） -->
	<div class="live-hero-scrim" aria-hidden="true"></div>

	<!-- 开场文字：大字（站点标题）常驻，小字（数据更新信息）在帘子过后淡入 -->
	<div class="live-hero-center">
		<p class="live-hero-center-title">{hero.title}</p>
		{hasIntroLines && (
			<p class="live-hero-center-lines">
				{hero.introLines.map((line) => (
					<span class="live-hero-line">{line}</span>
				))}
			</p>
		)}
		{hasSmallLine && <p class="live-hero-center-meta">{smallLine}</p>}
	</div>

	<!-- 右侧品牌图：参考里右侧 12%、垂直居中，帘子过后 1s 淡入 -->
	{hero.logo && <img class="live-hero-logo" src={url(hero.logo)} alt="" />}

	<!-- 开场帘子：整屏实色块向下退场，上缘 5 层浪尖领跑 -->
	<div class="live-hero-curtain" data-hero-curtain aria-hidden="true">
		{CURTAIN_LAYERS.map((layer) => (
			<img
				class={`live-hero-curtain-wave wave-${layer}`}
				src={url(`/images/live-hero/wave-${layer}.svg`)}
				alt=""
			/>
		))}
	</div>
</live-hero-fade>

<style>
	.live-hero {
		position: absolute;
		inset: 0;
		overflow: hidden;
		background-color: #469ce5;
	}

	/* ── 背景 ────────────────────────────────────────── */
	.live-hero-bg {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.live-hero-video {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 内置动画背景（视频未配置或加载失败时显示）：深蓝底 + 缓慢漂移的光带 */
	.live-hero-backdrop {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		background: radial-gradient(
			circle at 50% 42%,
			#17456f 0%,
			#0b1c2f 52%,
			#05080f 100%
		);
	}

	.live-hero-band {
		position: absolute;
		left: -30%;
		width: 160%;
		height: 24%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(70, 156, 229, 0.55),
			transparent
		);
		filter: blur(26px);
		will-change: transform;
	}

	.live-hero-band.band-1 {
		top: 14%;
		transform: rotate(-13deg);
		animation: live-hero-drift 16s ease-in-out infinite;
	}

	.live-hero-band.band-2 {
		top: 46%;
		opacity: 0.72;
		transform: rotate(-9deg);
		animation: live-hero-drift 21s ease-in-out infinite reverse;
	}

	.live-hero-band.band-3 {
		top: 74%;
		opacity: 0.5;
		transform: rotate(-16deg);
		animation: live-hero-drift 26s ease-in-out infinite;
	}

	@keyframes live-hero-drift {
		50% {
			transform: translate3d(5%, 4%, 0) rotate(-13deg);
		}
	}

	.live-hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 50% 50%,
			rgba(70, 156, 229, 0.28),
			transparent 62%
		);
		animation: live-hero-glow 11s ease-in-out infinite;
	}

	@keyframes live-hero-glow {
		50% {
			opacity: 0.55;
		}
	}

	/* 轻压暗层：白字在视频上仍可读（文字在这里是常驻的，参考里文字会淡出所以没有这层） */
	.live-hero-scrim {
		position: absolute;
		inset: 0;
		z-index: 2;
		background:
			radial-gradient(
				ellipse at 50% 45%,
				rgba(0, 0, 0, 0.05) 0%,
				rgba(0, 0, 0, 0.4) 78%
			),
			linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0.22) 0%,
				rgba(0, 0, 0, 0.38) 100%
			);
	}

	/* ── 开场文字 ────────────────────────────────────── */
	.live-hero-center {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 3;
		width: min(92%, 48rem);
		text-align: center;
		color: #fff;
		transform: translate(-50%, -50%);
	}

	.live-hero-center-title {
		font-size: clamp(2.2rem, 7vw, 4rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: 0.02em;
		text-shadow: 0 4px 30px rgba(0, 0, 0, 0.55);
	}

	.live-hero-center-lines {
		margin-top: 0.9rem;
		font-size: clamp(0.85rem, 2.4vw, 1.05rem);
		line-height: 1.85;
		opacity: 0.94;
	}

	.live-hero-line {
		display: block;
	}

	/* 小字（数据更新信息）：帘子退场后淡入，常驻 */
	.live-hero-center-meta {
		margin-top: 1.1rem;
		font-size: 0.78rem;
		line-height: 1.7;
		opacity: 0;
		animation: live-hero-meta-in 1s ease-out var(--curtain-end, 4s) forwards;
	}

	@keyframes live-hero-meta-in {
		to {
			opacity: 0.92;
		}
	}

	/* ── 右侧品牌图 ──────────────────────────────────── */
	.live-hero-logo {
		position: absolute;
		top: 50%;
		right: 12%;
		z-index: 4;
		max-width: 26vw;
		opacity: 0;
		transform: translateY(-50%);
		animation: live-hero-logo-in 1.5s linear var(--logo-fade-delay, 5s) forwards;
	}

	@keyframes live-hero-logo-in {
		to {
			opacity: 1;
		}
	}

	/* ── 开场帘子 ────────────────────────────────────── */
	.live-hero-curtain {
		position: absolute;
		top: -10%;
		right: 0;
		left: 0;
		z-index: 5;
		height: 120%;
		background-color: var(--hero-wave, #469ce5);
		animation: live-hero-curtain-sweep var(--curtain-duration, 3s) ease-out
			var(--curtain-delay, 1s) both;
		will-change: transform;
	}

	@keyframes live-hero-curtain-sweep {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(100%);
		}
	}

	/*
		浪尖挂在上缘：随帘子一起下移，成为退场时的浪形前沿。
		素材是 1920×200、ink 集中在底部约 1/4（浪脊），所以给固定高度 + preserveAspectRatio=none，
		让浪脊在任何屏宽下都保持可见高度（等比缩放的话窄屏会细到看不见）。
	*/
	.live-hero-curtain-wave {
		position: absolute;
		left: 0;
		width: 100%;
		height: 9vh;
		min-height: 2.5rem;
		will-change: transform;
	}

	.live-hero-curtain-wave.wave-1 {
		bottom: calc(100% - 0.1vw);
		opacity: 0.8;
		animation: live-wave-bob-1 5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-2 {
		bottom: calc(100% + 0.5vw);
		opacity: 0.7;
		animation: live-wave-bob-2 4s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-3 {
		bottom: calc(100% + 0.3vw);
		opacity: 0.6;
		animation: live-wave-bob-3 3.5s ease-in-out infinite;
	}

	.live-hero-curtain-wave.wave-4 {
		bottom: calc(100% + 0.1vw);
		opacity: 0.5;
		animation: live-wave-bob-4 3s ease-in-out infinite;
	}

	/* 第 5 层与参考的 #shape 一样不带动画，压在帘子上缘 */
	.live-hero-curtain-wave.wave-5 {
		bottom: calc(100% - 1vw);
		opacity: 1;
	}

	@keyframes live-wave-bob-1 {
		50% {
			transform: translateY(35px);
		}
	}

	@keyframes live-wave-bob-2 {
		50% {
			transform: translateY(25px);
		}
	}

	@keyframes live-wave-bob-3 {
		50% {
			transform: translateY(20px);
		}
	}

	@keyframes live-wave-bob-4 {
		50% {
			transform: translateY(20px);
		}
	}

	@media (max-width: 767px) {
		.live-hero-logo {
			right: 8%;
			max-width: 40vw;
		}
	}

	/* 减少动效：帘子/浮动/淡入淡出全部取消，直接呈现静态开场 */
	@media (prefers-reduced-motion: reduce) {
		.live-hero-curtain,
		.live-hero-curtain-wave,
		.live-hero-band,
		.live-hero-glow,
		.live-hero-logo {
			animation: none;
		}

		.live-hero-curtain {
			display: none;
		}

		.live-hero-logo {
			opacity: 1;
		}

		.live-hero-center-meta {
			opacity: 0.92;
		}
	}
</style>
